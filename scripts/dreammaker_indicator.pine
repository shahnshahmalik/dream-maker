// ═══════════════════════════════════════════════════════════════════════════
// Dream Maker — Stacked Sweep + BB/ORB Breakout Indicator
// Pine Script v5
// ═══════════════════════════════════════════════════════════════════════════

//@version=5
indicator("Dream Maker — Stacked Sweep + BB/ORB", overlay=true, max_lines_count=200, max_labels_count=100, max_boxes_count=50)

// ── INPUTS ──────────────────────────────────────────────────────────────────
show_emas        = input.bool(true,  "Show EMAs",                group="EMAs")
show_bb          = input.bool(true,  "Show BB",                  group="Bollinger Bands")
bb_period        = input.int(20,     "Period",                   group="Bollinger Bands")
bb_std           = input.float(2.0,  "Std Dev",                  group="Bollinger Bands")
show_vwap        = input.bool(true,  "Show VWAP",                group="VWAP")
show_or          = input.bool(true,  "Show OR",                  group="Opening Range")
or_bars          = input.int(3,      "OR candles (3=15m on 5m)", group="Opening Range", minval=1)
gap_thresh       = input.float(0.30, "Gap threshold %",          group="Day Type", step=0.05)
range_thresh     = input.float(0.80, "Range day full-range %",   group="Day Type", step=0.05)
show_day_lbl     = input.bool(true,  "Show day-type label",      group="Day Type")
show_swing       = input.bool(true,  "Show swing highs/lows",    group="Liquidity Levels")
show_eqhl        = input.bool(true,  "Show equal H/L clusters",  group="Liquidity Levels")
swing_lb         = input.int(5,      "Swing lookback",            group="Liquidity Levels", minval=2)
eq_tol_pct       = input.float(0.20, "Equal level tolerance %",  group="Liquidity Levels", step=0.05)
show_sweep       = input.bool(true,  "Show sweep signals",        group="Stacked Sweep")
wick_min         = input.float(0.10, "Min wick breach %",         group="Stacked Sweep", step=0.05)
show_bborb       = input.bool(true,  "Show BB+ORB signals",       group="BB+ORB Breakout")
show_levels      = input.bool(true,  "Show SL/TP on signals",     group="ATR / SL / TP")
atr_period       = input.int(14,     "ATR period",                group="ATR / SL / TP")
sl_mult          = input.float(1.0,  "SL multiplier",             group="ATR / SL / TP", step=0.1)
tp_mult          = input.float(2.0,  "TP multiplier",             group="ATR / SL / TP", step=0.1)
show_table       = input.bool(true,  "Show info table",           group="Display")
show_stoch_bg    = input.bool(true,  "Stoch OB/OS background",    group="Display")

// ── COMPUTED VALUES ──────────────────────────────────────────────────────────
ema_9   = ta.ema(close, 9)
ema_21  = ta.ema(close, 21)
ema_50  = ta.ema(close, 50)
ema_200 = ta.ema(close, 200)
[bb_mid, bb_upper, bb_lower] = ta.bb(close, bb_period, bb_std)
vwap_val = ta.vwap(hlc3)
atr      = ta.atr(atr_period)
k_raw    = ta.stoch(close, high, low, 14)
k_line   = ta.sma(k_raw, 3)

// ── OPENING RANGE ─────────────────────────────────────────────────────────
is_new_day  = ta.change(time("D")) != 0

var float or_high = na
var float or_low  = na
var int   day_bar = 0
var bool  or_done = false

if is_new_day
    or_high  := high
    or_low   := low
    day_bar  := 1
    or_done  := false
else
    day_bar += 1
    if day_bar <= or_bars
        or_high := math.max(or_high, high)
        or_low  := math.min(or_low, low)
    if day_bar == or_bars
        or_done := true

// ── DAY TYPE ──────────────────────────────────────────────────────────────
d_close_prev = request.security(syminfo.tickerid, "D", close[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
d_open_d     = request.security(syminfo.tickerid, "D", open,     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
d_high_d     = request.security(syminfo.tickerid, "D", high,     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
d_low_d      = request.security(syminfo.tickerid, "D", low,      gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
d_ema20      = request.security(syminfo.tickerid, "D", ta.ema(close, 20), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
d_close_cur  = request.security(syminfo.tickerid, "D", close,    gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

gap_pct       = d_close_prev != 0 ? (d_open_d - d_close_prev) / d_close_prev * 100 : 0.0
is_gap_up     = gap_pct >  gap_thresh
is_gap_down   = gap_pct < -gap_thresh
is_gap_day    = is_gap_up or is_gap_down
day_range_pct = d_close_prev != 0 ? (d_high_d - d_low_d) / d_close_prev * 100 : 0.0
is_range_day  = day_range_pct < range_thresh and not is_gap_day
daily_uptrend = d_close_cur > d_ema20
or_mid        = or_done ? (or_high + or_low) / 2 : na
or_bull_struct = close > or_mid

// Trend day: gap day OR day range > 1.5% with directional close
is_trending_up   = day_range_pct > 1.5 and close > d_open_d * 1.005
is_trending_down = day_range_pct > 1.5 and close < d_open_d * 0.995
is_trend_day     = is_gap_day or is_trending_up or is_trending_down

// Active strategy string
var string active_strategy = "STACKED SWEEP"
if is_range_day
    active_strategy := "NO TRADE"
else if is_trend_day
    active_strategy := "BB+ORB BREAKOUT"
else
    active_strategy := "STACKED SWEEP"

// Day-type label — fire once, one bar after OR completes
if show_day_lbl and or_done and day_bar == or_bars + 1
    bool  is_bull_day = is_gap_up or or_bull_struct
    color dt_col      = is_range_day ? color.gray : is_bull_day ? color.new(color.green, 10) : color.new(color.red, 10)
    string dt_txt     = ""
    if is_range_day
        dt_txt := "⏸ RANGE DAY — No Trades"
    else if is_gap_up
        dt_txt := "⬆ GAP UP — BB+ORB"
    else if is_gap_down
        dt_txt := "⬇ GAP DOWN — BB+ORB"
    else if or_bull_struct
        dt_txt := "🔄 V-REV BULL — Stacked Sweep LONG"
    else
        dt_txt := "🔄 V-REV BEAR — Stacked Sweep SHORT"
    label.new(bar_index, high + atr * 1.5, dt_txt, color=dt_col, textcolor=color.white, style=label.style_label_down, size=size.small)

// ── SWING HIGHS / LOWS ────────────────────────────────────────────────────
swing_high = ta.pivothigh(high, swing_lb, swing_lb)
swing_low  = ta.pivotlow(low, swing_lb, swing_lb)

if show_swing and not na(swing_high)
    line.new(bar_index[swing_lb], swing_high, bar_index, swing_high, color=color.new(color.red, 40), style=line.style_dashed, width=1)

if show_swing and not na(swing_low)
    line.new(bar_index[swing_lb], swing_low, bar_index, swing_low, color=color.new(color.green, 40), style=line.style_dashed, width=1)

plotshape(show_swing and not na(swing_high), "Swing High", shape.triangledown, location.abovebar, color.new(color.red, 30), offset=-swing_lb, size=size.tiny)
plotshape(show_swing and not na(swing_low),  "Swing Low",  shape.triangleup,   location.belowbar, color.new(color.green, 30), offset=-swing_lb, size=size.tiny)

// ── EQUAL HIGHS / LOWS ───────────────────────────────────────────────────
var float[] sh_hist = array.new_float()
var float[] sl_hist = array.new_float()
eq_tol = eq_tol_pct / 100.0

if not na(swing_high)
    array.unshift(sh_hist, swing_high)
    if array.size(sh_hist) > 12
        array.pop(sh_hist)

if not na(swing_low)
    array.unshift(sl_hist, swing_low)
    if array.size(sl_hist) > 12
        array.pop(sl_hist)

var bool is_equal_high = false
var bool is_equal_low  = false
is_equal_high := false
is_equal_low  := false

if not na(swing_high) and array.size(sh_hist) > 1
    for i = 1 to math.min(array.size(sh_hist) - 1, 11)
        if math.abs(swing_high - array.get(sh_hist, i)) / array.get(sh_hist, i) < eq_tol
            is_equal_high := true
            break

if not na(swing_low) and array.size(sl_hist) > 1
    for i = 1 to math.min(array.size(sl_hist) - 1, 11)
        if math.abs(swing_low - array.get(sl_hist, i)) / array.get(sl_hist, i) < eq_tol
            is_equal_low := true
            break

plotshape(show_eqhl and is_equal_high, "Equal Highs", shape.diamond, location.abovebar, color.new(color.orange, 0), offset=-swing_lb, size=size.small)
plotshape(show_eqhl and is_equal_low,  "Equal Lows",  shape.diamond, location.belowbar, color.new(color.lime, 0),   offset=-swing_lb, size=size.small)

// ── LAST SWING LEVELS ─────────────────────────────────────────────────────
var float last_sh = na
var float last_sl = na
if not na(swing_high)
    last_sh := swing_high
if not na(swing_low)
    last_sl := swing_low

// ── STACKED SWEEP DETECTION ───────────────────────────────────────────────
bool bull_sweep_raw = not na(last_sl) and low < last_sl * (1 - wick_min / 100) and close > last_sl
bool bear_sweep_raw = not na(last_sh) and high > last_sh * (1 + wick_min / 100) and close < last_sh

bool near_or_low  = not na(or_low)  and math.abs(low  - or_low)  / or_low  < 0.005
bool near_or_high = not na(or_high) and math.abs(high - or_high) / or_high < 0.005

int bull_lvl_count = (bull_sweep_raw ? 1 : 0) + (is_equal_low and bull_sweep_raw ? 1 : 0) + (near_or_low and bull_sweep_raw ? 1 : 0)
int bear_lvl_count = (bear_sweep_raw ? 1 : 0) + (is_equal_high and bear_sweep_raw ? 1 : 0) + (near_or_high and bear_sweep_raw ? 1 : 0)

bool bull_stacked = bull_lvl_count >= 2
bool bear_stacked = bear_lvl_count >= 2

bool bull_sweep_signal = show_sweep and bull_stacked and daily_uptrend and not is_range_day and not is_trend_day
bool bear_sweep_signal = show_sweep and bear_stacked and not daily_uptrend and not is_range_day and not is_trend_day

// ── BB + ORB BREAKOUT DETECTION ───────────────────────────────────────────
bool orb_long_break  = or_done and close > or_high and close[1] <= or_high[1]
bool orb_short_break = or_done and close < or_low  and close[1] >= or_low[1]

bool bb_orb_long  = show_bborb and is_trend_day and orb_long_break  and close > bb_upper and ema_9 > ema_21 and not is_range_day
bool bb_orb_short = show_bborb and is_trend_day and orb_short_break and close < bb_lower and ema_9 < ema_21 and not is_range_day

// ── PLOTS — EMAs ──────────────────────────────────────────────────────────
plot(show_emas ? ema_9   : na, "EMA 9",   color=color.new(color.yellow, 0),  linewidth=1)
plot(show_emas ? ema_21  : na, "EMA 21",  color=color.new(color.orange, 0),  linewidth=1)
plot(show_emas ? ema_50  : na, "EMA 50",  color=color.new(color.blue, 30),   linewidth=2)
plot(show_emas ? ema_200 : na, "EMA 200", color=color.new(color.red, 30),    linewidth=2)

// ── PLOTS — Bollinger Bands ───────────────────────────────────────────────
bb_up_p = plot(show_bb ? bb_upper : na, "BB Upper", color=color.new(color.purple, 40), linewidth=1)
bb_lo_p = plot(show_bb ? bb_lower : na, "BB Lower", color=color.new(color.purple, 40), linewidth=1)
fill(bb_up_p, bb_lo_p, color=color.new(color.purple, 88), title="BB Fill")
plot(show_bb ? bb_mid : na, "BB Mid", color=color.new(color.purple, 60), linewidth=1, style=plot.style_circles)

// ── PLOTS — VWAP ─────────────────────────────────────────────────────────
plot(show_vwap ? vwap_val : na, "VWAP", color=color.new(color.teal, 0), linewidth=2)

// ── PLOTS — Opening Range ────────────────────────────────────────────────
or_h_plot = plot(show_or ? or_high : na, "OR High", color=color.new(color.green, 20), linewidth=2, style=plot.style_stepline)
or_l_plot = plot(show_or ? or_low  : na, "OR Low",  color=color.new(color.red, 20),   linewidth=2, style=plot.style_stepline)
fill(or_h_plot, or_l_plot, color=color.new(color.gray, 92), title="OR Zone")

// ── SIGNAL SHAPES ─────────────────────────────────────────────────────────
plotshape(bull_sweep_signal, "Sweep LONG",   shape.arrowup,   location.belowbar, color.new(color.green,   0), size=size.normal)
plotshape(bear_sweep_signal, "Sweep SHORT",  shape.arrowdown, location.abovebar, color.new(color.red,     0), size=size.normal)
plotshape(bb_orb_long,       "BB+ORB LONG",  shape.circle,    location.belowbar, color.new(color.aqua,    0), size=size.small)
plotshape(bb_orb_short,      "BB+ORB SHORT", shape.circle,    location.abovebar, color.new(color.fuchsia, 0), size=size.small)

// ── SL / TP BOXES ─────────────────────────────────────────────────────────
if show_levels and bull_sweep_signal
    float e = close
    float s = e - atr * sl_mult
    float t = e + atr * tp_mult
    box.new(bar_index, t, bar_index + 15, s, border_color=color.green, border_width=1, bgcolor=color.new(color.green, 85))
    label.new(bar_index, s - atr * 0.4, "SWEEP LONG\nE: " + str.tostring(math.round(e, 2)) + "\nSL: " + str.tostring(math.round(s, 2)) + "\nTP: " + str.tostring(math.round(t, 2)), color=color.new(color.green, 10), textcolor=color.white, style=label.style_label_up, size=size.small)

if show_levels and bear_sweep_signal
    float e = close
    float s = e + atr * sl_mult
    float t = e - atr * tp_mult
    box.new(bar_index, s, bar_index + 15, t, border_color=color.red, border_width=1, bgcolor=color.new(color.red, 85))
    label.new(bar_index, s + atr * 0.4, "SWEEP SHORT\nE: " + str.tostring(math.round(e, 2)) + "\nSL: " + str.tostring(math.round(s, 2)) + "\nTP: " + str.tostring(math.round(t, 2)), color=color.new(color.red, 10), textcolor=color.white, style=label.style_label_down, size=size.small)

if show_levels and bb_orb_long
    float e = close
    float s = or_low - atr * 0.2
    float t = e + (e - s) * tp_mult
    box.new(bar_index, t, bar_index + 15, s, border_color=color.aqua, border_width=1, bgcolor=color.new(color.aqua, 88))
    label.new(bar_index, s - atr * 0.4, "BB+ORB LONG\nE: " + str.tostring(math.round(e, 2)) + "\nSL: " + str.tostring(math.round(s, 2)) + "\nTP: " + str.tostring(math.round(t, 2)), color=color.new(color.aqua, 10), textcolor=color.white, style=label.style_label_up, size=size.small)

if show_levels and bb_orb_short
    float e = close
    float s = or_high + atr * 0.2
    float t = e - (s - e) * tp_mult
    box.new(bar_index, s, bar_index + 15, t, border_color=color.fuchsia, border_width=1, bgcolor=color.new(color.fuchsia, 88))
    label.new(bar_index, s + atr * 0.4, "BB+ORB SHORT\nE: " + str.tostring(math.round(e, 2)) + "\nSL: " + str.tostring(math.round(s, 2)) + "\nTP: " + str.tostring(math.round(t, 2)), color=color.new(color.fuchsia, 10), textcolor=color.white, style=label.style_label_down, size=size.small)

// ── STOCHASTIC BACKGROUND ────────────────────────────────────────────────
bgcolor(show_stoch_bg and k_line < 20 ? color.new(color.green, 92) : na, title="Stoch Oversold")
bgcolor(show_stoch_bg and k_line > 80 ? color.new(color.red,   92) : na, title="Stoch Overbought")

// ── INFO TABLE ───────────────────────────────────────────────────────────
if show_table and barstate.islast
    var table t = table.new(position.top_right, 2, 9, bgcolor=color.new(color.black, 15), border_width=1, border_color=color.new(color.gray, 50))
    table.cell(t, 0, 0, "Dream Maker",  bgcolor=color.new(color.navy, 0), text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, syminfo.ticker, bgcolor=color.new(color.navy, 0), text_color=color.aqua,  text_size=size.small)
    table.cell(t, 0, 1, "Day Type",   text_color=color.white, text_size=size.small)
    string dt_str = is_range_day ? "⏸ RANGE" : is_gap_up ? "⬆ GAP UP" : is_gap_down ? "⬇ GAP DOWN" : or_bull_struct ? "🔄 V-REV BULL" : "🔄 V-REV BEAR"
    color  dt_clr = is_range_day ? color.gray : (or_bull_struct or is_gap_up) ? color.lime : color.red
    table.cell(t, 1, 1, dt_str, text_color=dt_clr, text_size=size.small)
    table.cell(t, 0, 2, "Strategy",   text_color=color.white, text_size=size.small)
    color strat_clr = is_range_day ? color.gray : is_trend_day ? color.aqua : color.green
    table.cell(t, 1, 2, active_strategy, text_color=strat_clr, text_size=size.small)
    table.cell(t, 0, 3, "Daily Trend", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 3, daily_uptrend ? "▲ BULL" : "▼ BEAR", text_color=daily_uptrend ? color.lime : color.red, text_size=size.small)
    table.cell(t, 0, 4, "ATR(14)",    text_color=color.white,  text_size=size.small)
    table.cell(t, 1, 4, str.tostring(math.round(atr, 2)), text_color=color.yellow, text_size=size.small)
    table.cell(t, 0, 5, "BB Upper",   text_color=color.white,  text_size=size.small)
    table.cell(t, 1, 5, str.tostring(math.round(bb_upper, 2)), text_color=color.new(color.purple, 0), text_size=size.small)
    table.cell(t, 0, 6, "BB Lower",   text_color=color.white,  text_size=size.small)
    table.cell(t, 1, 6, str.tostring(math.round(bb_lower, 2)), text_color=color.new(color.purple, 0), text_size=size.small)
    table.cell(t, 0, 7, "OR High",    text_color=color.white,  text_size=size.small)
    table.cell(t, 1, 7, or_done ? str.tostring(math.round(or_high, 2)) : "—", text_color=color.lime, text_size=size.small)
    table.cell(t, 0, 8, "OR Low",     text_color=color.white,  text_size=size.small)
    table.cell(t, 1, 8, or_done ? str.tostring(math.round(or_low, 2)) : "—", text_color=color.red, text_size=size.small)

// ── ALERTS ────────────────────────────────────────────────────────────────
alertcondition(bull_sweep_signal, "Stacked Sweep LONG",  "Dream Maker: Stacked Sweep LONG on {{ticker}} @ {{close}}")
alertcondition(bear_sweep_signal, "Stacked Sweep SHORT", "Dream Maker: Stacked Sweep SHORT on {{ticker}} @ {{close}}")
alertcondition(bb_orb_long,       "BB+ORB LONG",         "Dream Maker: BB+ORB Breakout LONG on {{ticker}} @ {{close}}")
alertcondition(bb_orb_short,      "BB+ORB SHORT",        "Dream Maker: BB+ORB Breakout SHORT on {{ticker}} @ {{close}}")
