// ═══════════════════════════════════════════════════════════════════════════
// Dream Maker — ICT/SMC Expiry Sniper (Tuesday, 1-minute)
// Pine Script v5
//
// Three-step ICT entry model
//   1. Liquidity Sweep  — wick through a swing high/low that closes back inside
//   2. Order Block (OB) — last opposite-body candle before the displacement impulse
//   3. OTE Entry        — price retraces 61.8–79 % (Fibonacci) back into the OB
//
// Visual elements
//   • Swing high/low levels (liquidity pools)
//   • Sweep arrows (green UP = bull sweep, red DOWN = bear sweep)
//   • OB box drawn on the chart (teal = LONG OB, orange = SHORT OB)
//   • OTE Fibonacci zone overlay (blue fill between 61.8 % and 79 % lines)
//   • Entry/SL/TP labels
//
// IMPORTANT — proxy methodology (same caveat as the other scalper strategies):
//   TradingView has no NIFTY option-premium feed. This strategy trades the
//   underlying symbol directly and scales premium-based SL/TP via a
//   "Premium leverage" divisor. Use it as an entry-signal-quality backtest.
//   India VIX and OI gates have no TradingView equivalent and are omitted.
//
// Recommended chart: NIFTY / NIFTY futures, 1-minute, Tuesdays only.
// ═══════════════════════════════════════════════════════════════════════════

//@version=5
strategy("Dream Maker — ICT Expiry Sniper (NIFTY 1m)", shorttitle="DM ICT Expiry",
     overlay=true, initial_capital=100000, currency=currency.INR,
     default_qty_type=strategy.percent_of_equity, default_qty_value=20,
     pyramiding=0, calc_on_every_tick=false, process_orders_on_close=false,
     commission_type=strategy.commission.percent, commission_value=0.03,
     slippage=2)

// ── Session ──────────────────────────────────────────────────────────────
g_sess = "Session"
only_tuesday     = input.bool(true, "Only enter on Tuesdays (expiry day)", group=g_sess)
kz_open_start_h  = input.int(9,  "Kill zone OPEN — start hour",   group=g_sess)
kz_open_start_m  = input.int(30, "Kill zone OPEN — start minute", group=g_sess)
kz_open_end_h    = input.int(11, "Kill zone OPEN — end hour",     group=g_sess)
kz_open_end_m    = input.int(0,  "Kill zone OPEN — end minute",   group=g_sess)
kz_pm_start_h    = input.int(13, "Kill zone PM — start hour",     group=g_sess)
kz_pm_start_m    = input.int(0,  "Kill zone PM — start minute",   group=g_sess)
kz_pm_end_h      = input.int(14, "Kill zone PM — end hour",       group=g_sess)
kz_pm_end_m      = input.int(15, "Kill zone PM — end minute",     group=g_sess)
theta_kill_h     = input.int(14, "Theta kill — hour",             group=g_sess)
theta_kill_m     = input.int(15, "Theta kill — minute",           group=g_sess)
mkt_close_h      = input.int(15, "Market close — hour",           group=g_sess)
mkt_close_m      = input.int(30, "Market close — minute",         group=g_sess)

// ── Liquidity sweep ───────────────────────────────────────────────────────
g_sweep = "Liquidity sweep"
swing_lb      = input.int(5,    "Swing lookback (bars each side)", group=g_sweep, minval=2)
sweep_wick_pct = input.float(0.10, "Min wick breach % through level", group=g_sweep, step=0.05)
eq_tol_pct    = input.float(0.20, "Equal-level tolerance %",        group=g_sweep, step=0.05)

// ── Order Block ───────────────────────────────────────────────────────────
g_ob = "Order Block"
ob_lookback     = input.int(8,   "OB — displacement scan (bars)", group=g_ob, minval=3)
ob_min_body_pct = input.float(0.30, "OB — min body / range ratio", group=g_ob, step=0.05,
     tooltip="Displacement candle must have body >= this fraction of its high-low range (filters doji impulses).")
ob_max_age_bars = input.int(20,  "OB max age before discarding (bars)", group=g_ob)
show_ob_box     = input.bool(true, "Draw OB box on chart", group=g_ob)
show_ote_zone   = input.bool(true, "Draw OTE fib zone on chart", group=g_ob)

// ── OTE Fibonacci ─────────────────────────────────────────────────────────
g_ote = "OTE Fibonacci zone"
ote_fib_low  = input.float(61.8, "OTE low %  (default 61.8)", group=g_ote, step=0.1)
ote_fib_high = input.float(79.0, "OTE high % (default 79.0)", group=g_ote, step=0.1)

// ── Risk (premium % scaled to underlying) ────────────────────────────────
g_risk = "Risk (premium % → underlying)"
sl_pct_premium       = input.float(15.0, "SL % of premium beyond OB", group=g_risk)
tp_mode              = input.string("swept_level", "TP mode", options=["swept_level","rr"], group=g_risk)
tp_rr_multiple       = input.float(2.0,  "TP R:R multiple (when mode=rr)", group=g_risk)
premium_leverage     = input.float(5.0,  "Premium leverage (elasticity divisor)", group=g_risk,
     tooltip="ATM weekly NIFTY options move ~this many times faster than the underlying intraday.")
trail_activate_pct   = input.float(12.0, "Trail activates at +% premium gain", group=g_risk)
trail_be_buffer_pct  = input.float(2.0,  "Breakeven buffer % premium", group=g_risk)
trail_from_peak_pct  = input.float(8.0,  "Trail distance behind peak % premium", group=g_risk)

// ── Trade limits ─────────────────────────────────────────────────────────
g_lim = "Trade limits"
max_trades             = input.int(3,   "Max trades per day", group=g_lim)
cooldown_win_secs      = input.int(90,  "Cooldown after win (s)", group=g_lim)
cooldown_loss_secs     = input.int(180, "Cooldown after loss (s)", group=g_lim)
max_consecutive_losses = input.int(2,   "Halt after N consecutive losses", group=g_lim)

// ── Daily risk ────────────────────────────────────────────────────────────
g_day = "Daily risk"
daily_target_pct   = input.float(2.0, "Daily profit target % — stop", group=g_day)
daily_max_loss_pct = input.float(1.5, "Daily max loss % — stop",      group=g_day)

// ── Position sizing ───────────────────────────────────────────────────────
qty_pct = input.float(20.0, "% of equity per trade", group="Position sizing")

// ═══════════════════════════════════════════════════════════════════════════
// Time helpers
// ═══════════════════════════════════════════════════════════════════════════
is_tuesday    = dayofweek == dayofweek.tuesday
cur_hm        = hour * 60 + minute
kz_open_start = kz_open_start_h * 60 + kz_open_start_m
kz_open_end   = kz_open_end_h   * 60 + kz_open_end_m
kz_pm_start   = kz_pm_start_h   * 60 + kz_pm_start_m
kz_pm_end     = kz_pm_end_h     * 60 + kz_pm_end_m
theta_kill    = theta_kill_h    * 60 + theta_kill_m
mkt_close     = mkt_close_h     * 60 + mkt_close_m

in_kill_zone   = (cur_hm >= kz_open_start and cur_hm < kz_open_end) or (cur_hm >= kz_pm_start and cur_hm < kz_pm_end)
in_dead_zone   = (cur_hm >= kz_open_end and cur_hm < kz_pm_start)
past_theta     = cur_hm >= theta_kill
past_close     = cur_hm >= mkt_close
new_day        = ta.change(time("D")) != 0

// ═══════════════════════════════════════════════════════════════════════════
// Daily state
// ═══════════════════════════════════════════════════════════════════════════
var int   trades_today        = 0
var float day_realized_pct    = 0.0
var int   consecutive_losses  = 0
var bool  halted_today        = false
var int   cooldown_until_bar  = 0
var int   last_closed_count   = 0

if new_day
    trades_today := 0
    day_realized_pct := 0.0
    consecutive_losses := 0
    halted_today := false
    cooldown_until_bar := 0

// ═══════════════════════════════════════════════════════════════════════════
// Swing levels (liquidity pools)
// ═══════════════════════════════════════════════════════════════════════════
swing_high_val = ta.pivothigh(high, swing_lb, swing_lb)
swing_low_val  = ta.pivotlow(low,  swing_lb, swing_lb)

var float last_sh = na
var float last_sl = na
if not na(swing_high_val)
    last_sh := swing_high_val
if not na(swing_low_val)
    last_sl := swing_low_val

// Equal highs / lows detection
var float[] sh_hist = array.new_float(0)
var float[] sl_hist = array.new_float(0)
eq_tol = eq_tol_pct / 100.0

if not na(swing_high_val)
    array.unshift(sh_hist, swing_high_val)
    if array.size(sh_hist) > 12
        array.pop(sh_hist)

if not na(swing_low_val)
    array.unshift(sl_hist, swing_low_val)
    if array.size(sl_hist) > 12
        array.pop(sl_hist)

var bool is_eqh = false
var bool is_eql = false
is_eqh := false
is_eql := false

if not na(swing_high_val) and array.size(sh_hist) > 1
    for i = 1 to math.min(array.size(sh_hist) - 1, 11)
        if math.abs(swing_high_val - array.get(sh_hist, i)) / array.get(sh_hist, i) < eq_tol
            is_eqh := true
            break

if not na(swing_low_val) and array.size(sl_hist) > 1
    for i = 1 to math.min(array.size(sl_hist) - 1, 11)
        if math.abs(swing_low_val - array.get(sl_hist, i)) / array.get(sl_hist, i) < eq_tol
            is_eql := true
            break

// ═══════════════════════════════════════════════════════════════════════════
// Liquidity sweep detection
// ═══════════════════════════════════════════════════════════════════════════
wick_thresh = sweep_wick_pct / 100.0

// Bull sweep: wick BELOW swing low, close BACK ABOVE it
bull_swept = not na(last_sl) and low[1] < last_sl * (1 - wick_thresh) and close[1] > last_sl

// Bear sweep: wick ABOVE swing high, close BACK BELOW it
bear_swept = not na(last_sh) and high[1] > last_sh * (1 + wick_thresh) and close[1] < last_sh

// Sweeping equal levels is higher conviction
bull_sweep_strength = bull_swept ? (is_eql ? 0.75 : 0.55) : 0.0
bear_sweep_strength = bear_swept ? (is_eqh ? 0.75 : 0.55) : 0.0

sweep_long  = bull_swept and not na(last_sl)
sweep_short = bear_swept and not na(last_sh)

// ═══════════════════════════════════════════════════════════════════════════
// Order Block detection
// Post-sweep: find the last opposite-body displacement candle, then walk
// back to the last candle with the opposite body = the Order Block.
// ═══════════════════════════════════════════════════════════════════════════

// Helper: find displacement bar (largest body among last ob_lookback bars)
f_find_disp_bull(lookback) =>
    best_idx = 0
    best_body = 0.0
    for i = 1 to lookback
        bdy = close[i] > open[i] ? close[i] - open[i] : 0.0
        rng = high[i] - low[i]
        if rng > 0 and bdy / rng >= ob_min_body_pct and bdy > best_body
            best_body := bdy
            best_idx  := i
    best_idx

f_find_disp_bear(lookback) =>
    best_idx = 0
    best_body = 0.0
    for i = 1 to lookback
        bdy = close[i] < open[i] ? open[i] - close[i] : 0.0
        rng = high[i] - low[i]
        if rng > 0 and bdy / rng >= ob_min_body_pct and bdy > best_body
            best_body := bdy
            best_idx  := i
    best_idx

// Walk back from displacement to the last opposite-body candle = OB
f_find_ob_from_disp(disp_offset, search_side) =>
    // search_side: 1 = look for bearish body (LONG OB), -1 = look for bullish body (SHORT OB)
    result_offset = 0
    for j = disp_offset + 1 to disp_offset + 10
        is_bear_body = close[j] < open[j]
        is_bull_body = close[j] > open[j]
        if search_side == 1 and is_bear_body
            result_offset := j
            break
        if search_side == -1 and is_bull_body
            result_offset := j
            break
    result_offset

// Compute OB for LONG setup (after bull sweep)
disp_bull = sweep_long ? f_find_disp_bull(ob_lookback) : 0
ob_long_offset = sweep_long and disp_bull > 0 ? f_find_ob_from_disp(disp_bull, 1) : 0
have_ob_long = sweep_long and ob_long_offset > 0

float ob_long_high = have_ob_long ? high[ob_long_offset] : na
float ob_long_low  = have_ob_long ? low[ob_long_offset]  : na

// Compute OB for SHORT setup (after bear sweep)
disp_bear = sweep_short ? f_find_disp_bear(ob_lookback) : 0
ob_short_offset = sweep_short and disp_bear > 0 ? f_find_ob_from_disp(disp_bear, -1) : 0
have_ob_short = sweep_short and ob_short_offset > 0

float ob_short_high = have_ob_short ? high[ob_short_offset] : na
float ob_short_low  = have_ob_short ? low[ob_short_offset]  : na

// ═══════════════════════════════════════════════════════════════════════════
// OTE zone (61.8–79 % retracement of displacement leg)
// ═══════════════════════════════════════════════════════════════════════════
f_ote(swing_origin, disp_extreme, fib_low_pct, fib_high_pct, dir) =>
    span = math.abs(disp_extreme - swing_origin)
    float ote_lo = na
    float ote_hi = na
    if dir == 1  // LONG: retrace from disp_high back toward swing_low
        ote_hi := disp_extreme - span * (fib_low_pct  / 100.0)
        ote_lo := disp_extreme - span * (fib_high_pct / 100.0)
    else         // SHORT: retrace from disp_low back toward swing_high
        ote_lo := disp_extreme + span * (fib_low_pct  / 100.0)
        ote_hi := disp_extreme + span * (fib_high_pct / 100.0)
    [ote_lo, ote_hi]

// LONG OTE (relative to displacement high and swept swing low)
[ote_long_lo, ote_long_hi] = f_ote(
     not na(last_sl) ? last_sl : low,
     have_ob_long ? math.max(high, high[1]) : high,
     ote_fib_low, ote_fib_high, 1)

// SHORT OTE (relative to displacement low and swept swing high)
[ote_short_lo, ote_short_hi] = f_ote(
     not na(last_sh) ? last_sh : high,
     have_ob_short ? math.min(low, low[1]) : low,
     ote_fib_low, ote_fib_high, -1)

// OTE touch: close enters OTE zone that overlaps OB
ote_long_entry  = have_ob_long  and close >= ote_long_lo  and close <= ote_long_hi  and close >= ob_long_low  and close <= ob_long_high
ote_short_entry = have_ob_short and close <= ote_short_hi and close >= ote_short_lo and close >= ob_short_low and close <= ob_short_high

// ═══════════════════════════════════════════════════════════════════════════
// Entry gates
// ═══════════════════════════════════════════════════════════════════════════
day_ok   = not only_tuesday or is_tuesday
trade_ok = trades_today < max_trades
can_enter = day_ok and in_kill_zone and not past_theta and trade_ok
     and not halted_today and bar_index >= cooldown_until_bar
     and strategy.position_size == 0

// Scale risk from premium % to underlying % via leverage divisor
sl_pct_u          = sl_pct_premium          / 100.0 / premium_leverage
trail_act_u        = trail_activate_pct      / 100.0 / premium_leverage
trail_be_u         = trail_be_buffer_pct     / 100.0 / premium_leverage
trail_pk_u         = trail_from_peak_pct     / 100.0 / premium_leverage

// ── Entries ───────────────────────────────────────────────────────────────
if can_enter and ote_long_entry
    sl = ob_long_low  * (1 - sl_pct_u)
    tp = tp_mode == "rr" ? close + (close - sl) * tp_rr_multiple : not na(last_sl) ? last_sl + (not na(last_sh) ? last_sh - last_sl : close - sl) : close + (close - sl) * tp_rr_multiple
    strategy.entry("Long", strategy.long, qty=strategy.equity * qty_pct / 100 / close)
    strategy.exit("Exit Long", "Long", limit=tp, stop=sl)
    trades_today += 1
    label.new(bar_index, low, "ICT CE\nOTE", style=label.style_label_up, color=color.new(color.teal, 0), textcolor=color.white, size=size.small)

if can_enter and ote_short_entry
    sl = ob_short_high * (1 + sl_pct_u)
    tp = tp_mode == "rr" ? close - (sl - close) * tp_rr_multiple : not na(last_sh) ? last_sh - (not na(last_sl) ? last_sh - last_sl : sl - close) : close - (sl - close) * tp_rr_multiple
    strategy.entry("Short", strategy.short, qty=strategy.equity * qty_pct / 100 / close)
    strategy.exit("Exit Short", "Short", limit=tp, stop=sl)
    trades_today += 1
    label.new(bar_index, high, "ICT PE\nOTE", style=label.style_label_down, color=color.new(color.orange, 0), textcolor=color.white, size=size.small)

// ═══════════════════════════════════════════════════════════════════════════
// Trailing stop update (applied after the initial strategy.exit)
// Pine's built-in trail_points param is imprecise for pct — we recompute
// and update the exit level each bar via strategy.exit override.
// ═══════════════════════════════════════════════════════════════════════════
in_pos   = strategy.position_size != 0
is_long  = strategy.position_size > 0
ep       = strategy.position_avg_price

var float peak_px = na
if in_pos
    peak_px := na(peak_px) ? ep : (is_long ? math.max(peak_px, high) : math.min(peak_px, low))
else
    peak_px := na

if in_pos
    peak_gain = is_long ? (peak_px - ep) / ep : (ep - peak_px) / ep
    base_sl_  = is_long ? ep * (1 - sl_pct_u) : ep * (1 + sl_pct_u)
    trail_sl_ = base_sl_
    if peak_gain >= trail_act_u
        be_sl_   = is_long ? ep * (1 + trail_be_u)     : ep * (1 - trail_be_u)
        peak_sl_ = is_long ? peak_px * (1 - trail_pk_u) : peak_px * (1 + trail_pk_u)
        trail_sl_ := is_long ? math.max(be_sl_, peak_sl_) : math.min(be_sl_, peak_sl_)
        ceiling_  = is_long ? peak_px * 0.995 : peak_px * 1.005
        trail_sl_ := is_long ? math.min(trail_sl_, ceiling_) : math.max(trail_sl_, ceiling_)
        trail_sl_ := is_long ? math.max(trail_sl_, base_sl_) : math.min(trail_sl_, base_sl_)
    strategy.exit("Trail", from_entry=is_long ? "Long" : "Short", stop=trail_sl_)

// Force close at theta kill / market close
if in_pos and (past_theta or past_close)
    strategy.close_all(comment="Theta/EOD")

// ═══════════════════════════════════════════════════════════════════════════
// Daily PnL + cooldowns + halts
// ═══════════════════════════════════════════════════════════════════════════
if strategy.closedtrades > last_closed_count
    last_pnl      = strategy.closedtrades.profit(strategy.closedtrades - 1)
    last_pnl_pct  = strategy.equity != 0 ? last_pnl / strategy.equity * 100 : 0.0
    day_realized_pct += last_pnl_pct
    if last_pnl < 0
        consecutive_losses += 1
        cooldown_until_bar := bar_index + math.max(1, math.round(cooldown_loss_secs / timeframe.in_seconds()))
    else
        consecutive_losses := 0
        cooldown_until_bar := bar_index + math.max(1, math.round(cooldown_win_secs / timeframe.in_seconds()))
    last_closed_count := strategy.closedtrades

if day_realized_pct >= daily_target_pct or day_realized_pct <= -daily_max_loss_pct or consecutive_losses >= max_consecutive_losses
    halted_today := true

// ═══════════════════════════════════════════════════════════════════════════
// Visuals
// ═══════════════════════════════════════════════════════════════════════════

// Swing levels
plotshape(not na(swing_high_val), "Swing High", shape.triangledown, location.abovebar, color.new(color.red,   30), offset=-swing_lb, size=size.tiny)
plotshape(not na(swing_low_val),  "Swing Low",  shape.triangleup,   location.belowbar, color.new(color.green, 30), offset=-swing_lb, size=size.tiny)

// Sweep arrows (plotted at the sweep candle = bar[1])
plotshape(sweep_long,  "Bull Sweep", shape.arrowup,   location.belowbar, color.new(color.lime, 0), offset=-1, size=size.small)
plotshape(sweep_short, "Bear Sweep", shape.arrowdown, location.abovebar, color.new(color.red,  0), offset=-1, size=size.small)

// OB boxes
if show_ob_box and have_ob_long and not na(ob_long_high)
    box.new(bar_index[ob_long_offset], ob_long_high, bar_index + ob_max_age_bars, ob_long_low,
         border_color=color.teal, border_width=1, bgcolor=color.new(color.teal, 85))

if show_ob_box and have_ob_short and not na(ob_short_high)
    box.new(bar_index[ob_short_offset], ob_short_high, bar_index + ob_max_age_bars, ob_short_low,
         border_color=color.orange, border_width=1, bgcolor=color.new(color.orange, 85))

// OTE zone fills (plotted as lines; boxes show the fib band)
if show_ote_zone and have_ob_long and not na(ote_long_hi)
    box.new(bar_index, ote_long_hi, bar_index + ob_max_age_bars, ote_long_lo,
         border_color=color.new(color.blue, 0), border_width=1, bgcolor=color.new(color.blue, 88))

if show_ote_zone and have_ob_short and not na(ote_short_hi)
    box.new(bar_index, ote_short_hi, bar_index + ob_max_age_bars, ote_short_lo,
         border_color=color.new(color.purple, 0), border_width=1, bgcolor=color.new(color.purple, 88))

// Kill zone shading
bgcolor(in_kill_zone  ? color.new(color.green, 96) : na, title="Kill zone")
bgcolor(in_dead_zone  ? color.new(color.gray,  90) : na, title="Dead zone")
bgcolor(past_theta and not past_close ? color.new(color.red,    92) : na, title="Post theta-kill")
bgcolor(halted_today  ? color.new(color.orange, 90) : na, title="Daily halt")

// VWAP
vwap_v = ta.vwap(hlc3)
plot(vwap_v, "VWAP", color=color.new(color.teal, 0), linewidth=2)

// Info table
var table info = table.new(position.top_right, 2, 7, bgcolor=color.new(color.black, 15), border_width=1, border_color=color.new(color.gray, 50))
if barstate.islast
    table.cell(info, 0, 0, "ICT Expiry Sniper", bgcolor=color.new(color.navy, 0), text_color=color.white, text_size=size.small)
    table.cell(info, 1, 0, syminfo.ticker,       bgcolor=color.new(color.navy, 0), text_color=color.aqua,  text_size=size.small)
    table.cell(info, 0, 1, "Trades today", text_color=color.white,  text_size=size.small)
    table.cell(info, 1, 1, str.tostring(trades_today) + "/" + str.tostring(max_trades), text_color=color.yellow, text_size=size.small)
    table.cell(info, 0, 2, "Day PnL %",   text_color=color.white,  text_size=size.small)
    table.cell(info, 1, 2, str.tostring(math.round(day_realized_pct, 2)), text_color=day_realized_pct >= 0 ? color.lime : color.red, text_size=size.small)
    table.cell(info, 0, 3, "In kill zone", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 3, in_kill_zone ? "YES" : "no",  text_color=in_kill_zone ? color.lime : color.gray, text_size=size.small)
    table.cell(info, 0, 4, "OB LONG",      text_color=color.white, text_size=size.small)
    table.cell(info, 1, 4, have_ob_long  ? str.tostring(math.round(ob_long_low,  2)) + "-" + str.tostring(math.round(ob_long_high,  2)) : "—", text_color=color.teal,   text_size=size.small)
    table.cell(info, 0, 5, "OB SHORT",     text_color=color.white, text_size=size.small)
    table.cell(info, 1, 5, have_ob_short ? str.tostring(math.round(ob_short_low, 2)) + "-" + str.tostring(math.round(ob_short_high, 2)) : "—", text_color=color.orange, text_size=size.small)
    table.cell(info, 0, 6, "Halted",       text_color=color.white, text_size=size.small)
    table.cell(info, 1, 6, halted_today ? "YES" : "no", text_color=halted_today ? color.red : color.lime, text_size=size.small)

// ═══════════════════════════════════════════════════════════════════════════
// Alerts
// ═══════════════════════════════════════════════════════════════════════════
alertcondition(can_enter and ote_long_entry,  "ICT Expiry CE (OTE)", "Dream Maker ICT Expiry: CE OTE entry on {{ticker}} @ {{close}}")
alertcondition(can_enter and ote_short_entry, "ICT Expiry PE (OTE)", "Dream Maker ICT Expiry: PE OTE entry on {{ticker}} @ {{close}}")
alertcondition(sweep_long,  "ICT Expiry Bull Sweep", "Dream Maker ICT Expiry: Bull liquidity sweep on {{ticker}}")
alertcondition(sweep_short, "ICT Expiry Bear Sweep", "Dream Maker ICT Expiry: Bear liquidity sweep on {{ticker}}")
