[Unit]
Description=Dream Maker Sniper — NIFTY Options Scalper (24x7)
Documentation=https://github.com/yourorg/dream-maker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/projects/dream-maker

# Run the guardian, which in turn spawns and monitors scripts/sniper.py
ExecStart=/usr/bin/python3 scripts/sniper_guardian.py

# Always restart the guardian itself — it handles child crash limits internally
Restart=always
RestartSec=30

# Give the child time to flush and exit cleanly on SIGTERM
TimeoutStopSec=30

# Write stdout/stderr to systemd journal (view with: journalctl -u sniper -f)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sniper

# Environment — override any of these in /etc/systemd/system/sniper.service.d/override.conf
# or in a .env file at the project root (the sniper reads it directly)
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Kolkata

[Install]
WantedBy=multi-user.target
