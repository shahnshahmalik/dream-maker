# Broker credentials
DHAN_ACCESS_TOKEN=
DHAN_CLIENT_ID=
GROWW_SESSION_TOKEN=

# Single F&O symbol to trade (required)
TRADING_SYMBOL=NIFTY50IDX

# Risk / signal gates
MIN_RR_RATIO=3.0
MIN_SIGNAL_STRENGTH=0.65
AI_REVIEW_COOLDOWN_MIN=30
AI_ANALYSIS_COOLDOWN_MIN=60
ENTRY_ZONE_TOLERANCE_PCT=0.15

# Trailing SL + TP (when trade moves as expected)
TRAIL_ENABLED=true
TRAIL_ACTIVATE_PCT=0.5
TRAIL_SL_DISTANCE_PCT=0.35
TRAIL_TP_REWARD_PCT=1.0
TRAIL_BREAKEVEN_PROGRESS_PCT=20
TRAIL_BREAKEVEN_BUFFER_PCT=0.05

# Momentum scalps (tighter targets, multi-signal confirmation, bracket-only entries)
SCALP_ENABLED=true
SCALP_MIN_RR_RATIO=1.2
SCALP_MIN_SIGNAL_STRENGTH=0.55
SCALP_MAX_SL_PCT=0.35
SCALP_MIN_CONFIRMATIONS=2
SCALP_TRAIL_ACTIVATE_PCT=0.25
SCALP_TRAIL_SL_DISTANCE_PCT=0.2
SCALP_TRAIL_BREAKEVEN_PROGRESS_PCT=15

# Active providers (override config.yaml)
ACTIVE_BROKER=dhan
ACTIVE_LLM=deepseek

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Simulation mode
SIMULATION_MODE=true

# Auto symbol picker — selects best F&O instrument based on balance
AUTO_SYMBOL_PICKER=false
# Comma-separated preferred symbols (index > options > stocks)
PREFERRED_SYMBOLS=SENSEX,BANKNIFTY,NIFTY50IDX

# Telegram alerts (create a bot via @BotFather, then get chat id from @userinfobot or getUpdates)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_TRADES=true
TELEGRAM_NOTIFY_AI=true

# Optional overrides
MONITOR_INTERVAL=60
MARKET_CLOSED_POLL_INTERVAL=300
# Exit the process after session end. Default false — app runs 24x7, only trading pauses.
STOP_AT_MARKET_CLOSE=false
# Wait for market open when started early / on weekends (needed for auto-resume in one process)
WAIT_FOR_MARKET_OPEN=true
# Comma-separated NSE holidays (YYYY-MM-DD), e.g. 2026-01-26,2026-08-15
MARKET_HOLIDAYS=
MAX_OPEN_TRADES=3
RISK_PCT_PER_TRADE=1.5
DAILY_LOSS_LIMIT=5.0

# Persistence (optional — used by Docker)
# STATE_DIR=./state
# TRADE_LOG_PATH=./trade_log.jsonl
