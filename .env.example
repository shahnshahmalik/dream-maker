# Broker credentials
DHAN_ACCESS_TOKEN=
GROWW_SESSION_TOKEN=

# Single F&O symbol to trade (required)
TRADING_SYMBOL=NIFTY50IDX

# Risk / signal gates
MIN_RR_RATIO=3.0
MIN_SIGNAL_STRENGTH=0.65
AI_REVIEW_COOLDOWN_MIN=30
AI_ANALYSIS_COOLDOWN_MIN=60
ENTRY_ZONE_TOLERANCE_PCT=0.15

# Active providers (override config.yaml)
ACTIVE_BROKER=dhan
ACTIVE_LLM=openai_compat

# LLM credentials
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Trading mode
SIMULATION_MODE=true

# Optional overrides
MONITOR_INTERVAL=60
MAX_OPEN_TRADES=3
RISK_PCT_PER_TRADE=1.5
DAILY_LOSS_LIMIT=5.0
